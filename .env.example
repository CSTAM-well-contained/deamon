# CSTAM sandbox platform — every setting, with a comment.
# Copy to .env (`cp .env.example .env`) and edit. .env is git-ignored.

# --- Control plane ----------------------------------------------------------
# Postgres connection (async driver). In Docker mode postgres lives at 10.20.0.5.
DATABASE_URL=postgresql+asyncpg://cstam:cstam@10.20.0.5:5432/cstam
# How sandboxes are created: "docker" (local containers) or "openstack" (real VMs).
DRIVER=docker
# Every team gets <team>.<BASE_DOMAIN>.
BASE_DOMAIN=cstam.felcloud.tn

# --- IPAM (Criterion 3) -----------------------------------------------------
# First and last sandbox IP we hand out. Keep it outside Docker/Neutron auto ranges.
POOL_START=10.20.0.21
POOL_END=10.20.0.199

# --- Provisioning (Criterion 1) ---------------------------------------------
# How many ready-to-claim sandboxes we keep around.
WARM_POOL_SIZE=3
# Lease length when the request does not say (seconds).
DEFAULT_TTL_SECONDS=7200
# Longest lease a team can ask for (seconds).
MAX_TTL_SECONDS=86400

# --- Background jobs --------------------------------------------------------
# Reclaimer + warm pool run this often (seconds).
JOB_INTERVAL_SECONDS=5
# Gateway monitor polls agents this often (seconds).
MONITOR_INTERVAL_SECONDS=2

# --- Gateways (Criteria 2 + 4) ----------------------------------------------
# name=agent-url pairs, comma separated.
GATEWAYS=gw1=http://10.20.0.11:9000,gw2=http://10.20.0.12:9000
# Shared secret sent as X-Agent-Token to every gateway agent. CHANGE IT.
AGENT_TOKEN=change-me

# --- API protection ---------------------------------------------------------
# If set, every mutating endpoint needs the header X-API-Key: <value>.
API_KEY=

# --- OpenStack only (DRIVER=openstack) --------------------------------------
# Cloud name from clouds.yaml.
OS_CLOUD=felcloud
# Private network + subnet the sandboxes are plugged into.
OS_SANDBOX_NETWORK=cstam-sandbox-net
OS_SANDBOX_SUBNET=cstam-sandbox-subnet
# Image and flavor for sandbox VMs.
OS_SANDBOX_IMAGE=ubuntu-22.04
OS_SANDBOX_FLAVOR=m1.small
# Only this security group (the gateways) may reach sandboxes on port 80.
OS_GATEWAY_SECGROUP=cstam-gateway-sg
